---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import photo from '../assets/ignacio-criscenti.jpg';
import { profile } from '../data/profile';

const stats = [
  { value: '4.º', label: 'año de Ingeniería en Sistemas' },
  { value: '3', label: 'proyectos destacados' },
  { value: 'B2', label: 'nivel de inglés' },
  { value: '2025', label: 'título de Analista' },
];
---

<section id="inicio" aria-labelledby="hero-title" class="relative isolate overflow-hidden pt-24 pb-14 md:pt-28 md:pb-20">
  <div class="dot-field pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div
    class="hero-glow pointer-events-none absolute -top-32 left-1/2 -z-10 h-[38rem] w-[min(64rem,160vw)] -translate-x-1/2"
    aria-hidden="true"
  >
  </div>

  <div class="container-page">
    <div class="grid gap-4 lg:grid-cols-12">
      <!-- Presentación -->
      <div class="bento flex flex-col justify-center p-6 sm:p-10 lg:col-span-8">
        <p
          class="inline-flex w-fit items-center gap-2 rounded-full border border-ok/30 bg-ok-soft px-3 py-1 text-[0.8rem] font-semibold text-ok sm:text-sm"
        >
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-ok opacity-60 motion-reduce:hidden"></span>
            <span class="relative inline-flex size-2 rounded-full bg-ok"></span>
          </span>
          {profile.status}
        </p>

        <h1 id="hero-title" class="mt-6 text-[clamp(3rem,11vw,6.25rem)] font-extrabold tracking-[-0.04em]">
          <span class="text-shine block">{profile.firstName}</span>
          <span class="text-shine block">{profile.lastName}<span class="text-accent">.</span></span>
        </h1>

        <p class="mt-6 font-display text-xl font-semibold tracking-tight sm:text-2xl">{profile.role}</p>
        <p class="mt-1 text-muted">{profile.subtitle}</p>

        <p class="mt-6 max-w-xl border-l-2 border-accent pl-4 text-lg leading-relaxed sm:text-xl">
          {profile.tagline}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href="#proyectos" class="btn btn-primary">
            Ver proyectos
            <Icon name="arrow-down" class="size-4" />
          </a>
          <a href="#contacto" class="btn btn-secondary">Contactarme</a>
          <a
            href={profile.cv}
            download
            class="inline-flex min-h-11 items-center gap-2 rounded-md px-2 font-semibold text-accent transition-colors hover:text-accent-strong"
          >
            <Icon name="download" class="size-4" />
            <span class="link-underline">Descargar CV</span>
            <span class="sr-only">(PDF)</span>
          </a>
        </div>
      </div>

      <!-- Foto -->
      <div class="bento aspect-[4/5] sm:aspect-[5/4] lg:col-span-4 lg:aspect-auto lg:min-h-[32rem]">
        <Image
          src={photo}
          alt="Retrato de Ignacio Criscenti con camisa blanca, sonriendo levemente a cámara"
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 24rem, 100vw"
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 -z-20 size-full object-cover object-[50%_25%]"
        />
        <p class="glass absolute top-3 left-3 inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-sm font-semibold">
          <Icon name="pin" class="size-4 text-accent" />
          {profile.location}
        </p>
        <div class="glass absolute right-3 bottom-3 left-3 rounded-xl px-4 py-3">
          <p class="annotation !text-[0.68rem]">// stack principal</p>
          <p class="mt-0.5 font-mono text-sm font-semibold">TypeScript · Next.js · C# · SQL</p>
        </div>
      </div>

      <!-- Datos clave -->
      <dl class="grid grid-cols-2 gap-4 md:grid-cols-4 lg:col-span-12">
        {
          stats.map((s) => (
            <div class="bento flex flex-col-reverse p-5 sm:p-6">
              <dt class="mt-1 text-sm text-muted">{s.label}</dt>
              <dd class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
