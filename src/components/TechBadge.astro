---
// Badge de tecnología con el logo de la marca. Los logos vienen de Simple Icons y se
// embeben como SVG al compilar (no se descarga nada extra). Las marcas sin logo
// disponible (por ejemplo las de Microsoft) usan un ícono genérico.
import {
  siHtml5,
  siCss,
  siJavascript,
  siTypescript,
  siReact,
  siNextdotjs,
  siTailwindcss,
  siShadcnui,
  siBlazor,
  siNodedotjs,
  siDotnet,
  siJsonwebtokens,
  siMysql,
  siGit,
  siEslint,
  siUml,
} from 'simple-icons';

interface Props {
  name: string;
}
const { name } = Astro.props;

type Brand = { path: string; hex: string };

const brands: Record<string, Brand> = {
  HTML5: siHtml5,
  CSS3: siCss,
  JavaScript: siJavascript,
  TypeScript: siTypescript,
  React: siReact,
  'Next.js': siNextdotjs,
  'Tailwind CSS': siTailwindcss,
  'shadcn/ui': siShadcnui,
  Blazor: siBlazor,
  'Node.js': siNodedotjs,
  'Next.js API Routes': siNextdotjs,
  'C# / .NET 8': siDotnet,
  'ASP.NET Core': siDotnet,
  'JWT · Bcrypt': siJsonwebtokens,
  MySQL: siMysql,
  'Git & GitHub': siGit,
  ESLint: siEslint,
  'Diagramas UML': siUml,
};

// Íconos de trazo (mismo estilo que Icon.astro) para lo que no tiene logo de marca
const database =
  '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 1.66 3.58 3 8 3s8-1.34 8-3V5"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>';
const generic: Record<string, string> = {
  'Entity Framework Core': database,
  SQL: database,
  'Microsoft Access': database,
  'Bases no relacionales': database,
  'VS Code': '<path d="m8 8-4 4 4 4"/><path d="m16 8 4 4-4 4"/><path d="m14 5-4 14"/>',
  'Modelado de datos':
    '<rect x="3" y="3" width="7" height="6" rx="1"/><rect x="14" y="15" width="7" height="6" rx="1"/><path d="M6.5 9v4.5a2 2 0 0 0 2 2H14"/>',
  'Relevamiento de requisitos':
    '<rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3h6v1"/><path d="M9 11h6"/><path d="M9 15h4"/>',
};

// Si el color de la marca casi no contrasta con el fondo del badge, se usa el color del texto
const luminance = (hex: string) => {
  const [r, g, b] = [0, 2, 4].map((i) => {
    const c = parseInt(hex.slice(i, i + 2), 16) / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
const contrast = (a: string, b: string) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const colorOn = (hex: string, bg: string) => (contrast(hex, bg) >= 1.8 ? `#${hex}` : 'currentColor');

const brand = brands[name];
const style = brand
  ? `--brand: ${colorOn(brand.hex, 'ebe8e1')}; --brand-dark: ${colorOn(brand.hex, '1d2129')}`
  : undefined;
---

<li class="chip tech-badge" style={style}>
  {
    brand ? (
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={brand.path} />
      </svg>
    ) : generic[name] ? (
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        set:html={generic[name]}
      />
    ) : null
  }
  {name}
</li>
