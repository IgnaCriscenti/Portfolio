---
import SectionHeading from './SectionHeading.astro';
import TechBadge from './TechBadge.astro';
import { bio, facts, skills } from '../data/profile';

// Anchos alternados en la grilla bento: 7 + 5, después 5 + 7
const skillSpan = ['md:col-span-7', 'md:col-span-5', 'md:col-span-5', 'md:col-span-7'];
---

<section id="sobre-mi" aria-labelledby="sobre-mi-title" class="py-16 md:py-24">
  <div class="container-page">
    <SectionHeading id="sobre-mi-title" num="01" label="Sobre mí" title="Estructura primero, código después." />

    <div class="grid gap-4 md:grid-cols-12">
      <!-- Bio -->
      <div class="bento p-6 sm:p-8 md:col-span-7" data-reveal>
        <p class="annotation mb-5">// quién soy</p>
        <div class="space-y-5 text-lg leading-relaxed">
          {bio.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <!-- Ficha técnica -->
      <aside aria-label="Ficha técnica" class="bento md:col-span-5" data-reveal style="--reveal-delay: 100ms">
        <p class="annotation border-b border-line px-6 py-4">Ficha técnica</p>
        <dl class="divide-y divide-line">
          {
            facts.map((f) => (
              <div class="grid grid-cols-[6.5rem_1fr] gap-3 px-6 py-4">
                <dt class="pt-0.5 font-mono text-xs tracking-wide text-muted uppercase">{f.label}</dt>
                <dd>
                  <span class="block font-semibold">{f.value}</span>
                  <span class="block text-sm text-muted">{f.note}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </aside>
    </div>

    <!-- Habilidades -->
    <h3 class="annotation mt-16 mb-6 !font-mono !text-[0.78rem] !tracking-[0.04em]" data-reveal>
      Habilidades y tecnologías
    </h3>
    <ul class="grid gap-4 md:grid-cols-12">
      {
        skills.map((s, i) => (
          <li class:list={['bento group p-6', skillSpan[i]]} data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <div class="flex items-center justify-between gap-3">
              <h4 class="font-display text-xl font-semibold tracking-tight">{s.group}</h4>
              <span
                class="rounded-md border border-line px-1.5 py-0.5 font-mono text-[0.7rem] text-muted transition-colors group-hover:border-accent group-hover:text-accent"
                aria-hidden="true"
              >
                {s.code}
              </span>
            </div>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label={`Tecnologías de ${s.group}`}>
              {s.items.map((item) => (
                <TechBadge name={item} />
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
