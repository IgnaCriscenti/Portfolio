---
// Encabezado de sección con numeración estilo documento técnico: "01 / Sobre mí"
interface Props {
  id: string;
  num: string;
  label: string;
  title: string;
  intro?: string;
}
const { id, num, label, title, intro } = Astro.props;
---

<div class="mb-12 grid gap-4 border-t border-line pt-6 md:mb-16 md:grid-cols-12 md:gap-8" data-reveal>
  <p class="annotation md:col-span-3">
    <span class="text-accent">{num}</span> / {label}
  </p>
  <div class="md:col-span-9">
    <h2 id={id} class="text-[clamp(2.1rem,6vw,3.6rem)] font-bold">{title}</h2>
    {intro && <p class="mt-4 max-w-2xl text-lg text-muted">{intro}</p>}
  </div>
</div>
